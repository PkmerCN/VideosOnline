<!DOCTYPE generatorConfiguration PUBLIC
        "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<generatorConfiguration>

    <context id="MySQLTables1" targetRuntime="MyBatis3DynamicSql">
        <!-- 数据库关键字冲突,自动处理 -->
        <property name="autoDelimitKeywords" value="true"/>
        <!-- 用反引号`包裹,默认是双引号"-->
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>

        <plugin type="io.gitee.pkmer.mybatis.plugins.ConstantClassGeneratorPlugin">
            <!--    其他扩展信息        -->
            <property name="pkmer" value="hzz"/>
            <!--    修改生成的文件夹        -->
            <property name="targetPackage" value="org.hzz.coupon.types.constants"/>
        </plugin>

        <!--   使用自己的注释类     -->
        <commentGenerator type="io.gitee.pkmer.mybatis.common.MyCommentGenerator">
            <!--   不生成注释     -->
            <property name="suppressAllComments" value="true"/>
        </commentGenerator>

        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3308/videos_online?autoreconnect=true&amp;allowPublicKeyRetrieval=true&amp;characterEncoding=utf8&amp;useSSL=false&amp;serverTimezone=UTC"
                        userId="root"
                        password="Root.123456">
        </jdbcConnection>

        <javaTypeResolver>
            <property name="useJSR310Types" value="true" />
        </javaTypeResolver>

        <javaModelGenerator targetPackage="org.hzz.coupon.infrastructure.dao.model.coupon" targetProject="src/main/java" />
        <sqlMapGenerator targetPackage="mapper" targetProject="src/main/resources"/>
        <javaClientGenerator type="XMLMAPPER" targetPackage="org.hzz.coupon.infrastructure.dao.mapper.coupon" targetProject="src/main/java"/>

        <table tableName="coupon" mapperName="CouponDynamicMapper">
            <columnOverride column="status" javaType="org.hzz.promotions.types.enums.coupon.CouponStatus"/>
            <columnOverride column="discount_type" javaType="org.hzz.promotions.types.enums.coupon.DiscountType"/>
            <columnOverride column="obtain_way" javaType="org.hzz.promotions.types.enums.coupon.ObtainWay"/>
        </table>
        <table tableName="coupon_scope" mapperName="CouponScopeDynamicMapper">
            <columnOverride column="type" javaType="org.hzz.promotions.types.enums.coupon.CouponScopeType"/>
        </table>
<!--        <table tableName="points_board"/>-->
    </context>


